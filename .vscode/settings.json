{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/latex-workshop/%RELATIVE_DIR%/%DOCFILE%",
  "latex-workshop.latex.auxDir": "%OUTDIR%",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.build.rootfileInStatus": true,
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk current resume",
      "tools": [
        "latexmk-current-resume"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-current-resume",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC_EXT%"
      ],
      "cwd": "%WORKSPACE_FOLDER%",
      "env": {}
    }
  ],
  "latex-workshop.latex.clean.method": "command",
  "latex-workshop.latex.clean.command": "latexmk",
  "latex-workshop.latex.clean.args": [
    "-outdir=%OUTDIR%",
    "-c",
    "%DOC_EXT%"
  ]
}
